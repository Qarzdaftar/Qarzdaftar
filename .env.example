# Copy to .env locally; never commit actual values. Load with your process manager.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/qarz
PORT=4000
NODE_ENV=development
PUBLIC_ORIGIN=https://your-real-domain.example
TRUST_PROXY=0
# SMS remains disabled unless all live gates are explicitly enabled and provider approved.
SMS_LIVE_ENABLED=0
SMS_SENDER_APPROVED=0
PLAYMOBILE_APPROVED_SENDER=
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
SMS_CALLBACK_SECRET=
# Payme Merchant API stays OFF without merchant onboarding, sandbox verification
# and a separate, explicitly authorized production enablement. Never commit keys.
PAYME_CALLBACK_ENABLED=0
PAYME_CHECKOUT_MODE=sandbox
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_PRODUCTION_APPROVED=0
# Server-to-server reporting only. Never ship this bearer to browser JavaScript.
PLATFORM_REPORT_TOKEN=
